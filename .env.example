# --- Required in production (both Vercel and cPanel) ---
SITE_URL=https://rahultanwar.com
JWT_SECRET=replace-with-a-long-random-secret-at-least-16-chars
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# --- Contact form (SMTP) ---
CONTACT_TO_EMAIL=hello@rahultanwar.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=smtp-user
SMTP_PASS=smtp-password
SMTP_FROM="Rahul Tanwar Website <no-reply@rahultanwar.com>"

# --- Chat assistant (optional) ---
OPENAI_API_KEY=sk-proj-your-key
OPENAI_MODEL=gpt-4.1-mini

# --- CMS storage ---
# Vercel: add the Upstash Redis integration (Marketplace); it injects these two.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# cPanel / any Node host: leave Redis empty; edits are saved as JSON files in DATA_DIR.
# DATA_DIR=./data

# --- Rate limiting / proxies ---
# Number of trusted reverse proxies in front of the app (cPanel/Apache/Passenger, nginx...).
# The client IP is the Nth entry from the RIGHT of X-Forwarded-For. Default 1 = rightmost entry.
# 0 ignores X-Forwarded-For and uses X-Real-IP. Ignored on Vercel (uses x-real-ip).
# Confirm what your host's proxy sends; a client can forge anything to the left of it.
# TRUST_PROXY_HOPS=1
